    <script>
        /*
         * Navigaatiopalkin tausta, kun sivua on vieritetty.
         */
        (function () {
            const nav = document.getElementById('siteNav');

            if (!nav) {
                return;
            }

            const update = function () {
                nav.classList.toggle('is-scrolled', window.scrollY > 10);
            };

            update();
            window.addEventListener('scroll', update, { passive: true });
        })();

        /*
         * Sulkee kielivalikon, kun klikataan muualle.
         */
        (function () {
            const lang = document.querySelector('.lang');

            if (!lang) {
                return;
            }

            document.addEventListener('click', function (event) {
                if (lang.open && !lang.contains(event.target)) {
                    lang.open = false;
                }
            });

            document.addEventListener('keydown', function (event) {
                if (event.key === 'Escape' && lang.open) {
                    lang.open = false;
                }
            });
        })();

        /*
         * Lähettää yhteydenottolomakkeen Formspree-palveluun.
         */
        (function () {
            const form = document.getElementById('contactForm');

            if (!form) {
                return;
            }

            const statusElement =
                document.getElementById('contactFormStatus');

            form.addEventListener('submit', async function (event) {
                event.preventDefault();

                const submitButton =
                    form.querySelector('button[type="submit"]');

                if (submitButton) {
                    submitButton.disabled = true;
                }

                if (statusElement) {
                    statusElement.textContent = '';
                }

                try {
                    const formData = new FormData(form);

                    const response = await fetch(form.action, {
                        method: form.method,
                        body: formData,
                        headers: {
                            Accept: 'application/json'
                        }
                    });

                    if (response.ok) {
                        form.reset();

                        if (statusElement) {
                            statusElement.textContent =
                                'Danke! Deine Nachricht wurde gesendet.';
                        }

                        window.location.assign('/thanks/');
                        return;
                    }

                    if (statusElement) {
                        statusElement.textContent =
                            'Etwas ist schiefgelaufen. Bitte versuche es erneut.';
                    }
                } catch (error) {
                    if (statusElement) {
                        statusElement.textContent =
                            'Netzwerkfehler. Bitte versuche es erneut.';
                    }
                } finally {
                    if (submitButton) {
                        submitButton.disabled = false;
                    }
                }
            });
        })();
    </script>
    <script>
        // Scroll reveal: fade each block in once, then stop observing it.
        (function () {
            var root = document.documentElement;
            if (!root.classList.contains('reveal-on')) return;

            var targets = document.querySelectorAll('main .section-head, main .features > li, main .panel, main .ref-links > li, main .dc-usecase, main .card, main .form-card, .site-footer .container');

            function done(el) {
                el.classList.remove('revealing');
                el.style.removeProperty('--reveal-delay');
            }

            var observer = new IntersectionObserver(function (entries) {
                var batch = 0;
                entries.forEach(function (entry) {
                    var el = entry.target;
                    var above = entry.boundingClientRect.bottom < 0;
                    if (!entry.isIntersecting && !above) return;
                    observer.unobserve(el);
                    if (above) {
                        // Already scrolled past (e.g. anchor link or reload): show without animating.
                        el.classList.add('revealed');
                        return;
                    }
                    el.style.setProperty('--reveal-delay', Math.min(batch, 4) * 70 + 'ms');
                    batch++;
                    el.addEventListener('animationend', function onEnd(e) {
                        if (e.target !== el) return;
                        el.removeEventListener('animationend', onEnd);
                        done(el);
                    });
                    el.classList.add('revealing', 'revealed');
                });
            }, { rootMargin: '0px 0px -40px 0px' });

            targets.forEach(function (el) { observer.observe(el); });
        })();
    </script>
