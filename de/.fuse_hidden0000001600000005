    <style>
        /* =========================================================
         * Design tokens – dark "Reflect" style
         * ========================================================= */
        :root {
            --bg: #0b0a1f;
            --bg-deep: #08071a;
            --surface: #13112e;
            --surface-2: #1a1740;
            --border: rgba(255, 255, 255, 0.08);
            --border-strong: rgba(255, 255, 255, 0.14);
            --text: #ecebff;
            --text-strong: #ffffff;
            --muted: #a3a0c8;
            --faint: #7d7aa6;
            --accent: #7c5cff;
            --accent-2: #a78bfa;
            --accent-blue: #6d8dff;
            --pink: #c06bf0;
            --radius: 20px;
            --radius-lg: 28px;
            --max: 1180px;
        }

        * {
            box-sizing: border-box;
        }

        html {
            scroll-behavior: smooth;
            scroll-padding-top: 84px;
        }

        body {
            margin: 0;
            font-family:
                "Inter",
                -apple-system,
                BlinkMacSystemFont,
                "Segoe UI",
                Roboto,
                Helvetica,
                Arial,
                sans-serif;
            color: var(--text);
            background: var(--bg);
            line-height: 1.6;
            -webkit-font-smoothing: antialiased;
            overflow-x: hidden;
        }

        img {
            max-width: 100%;
            display: block;
        }

        a {
            color: inherit;
        }

        :focus-visible {
            outline: 2px solid var(--accent-2);
            outline-offset: 3px;
            border-radius: 6px;
        }

        .container {
            width: 100%;
            max-width: var(--max);
            margin: 0 auto;
            padding: 0 1.5rem;
        }

        .sr-only {
            position: absolute;
            width: 1px;
            height: 1px;
            padding: 0;
            margin: -1px;
            overflow: hidden;
            clip: rect(0, 0, 0, 0);
            border: 0;
        }

        /* Gradient text, like "Think better with Reflect" */
        .gradient-text {
            background: linear-gradient(90deg, #b9c3ff 0%, #ffffff 45%, #ffffff 60%, #d2b8ff 100%);
            -webkit-background-clip: text;
            background-clip: text;
            color: transparent;
        }

        .gradient-text--cool {
            background: linear-gradient(90deg, #c7d2fe 0%, #a5b4fc 50%, #93c5fd 100%);
            -webkit-background-clip: text;
            background-clip: text;
            color: transparent;
        }

        .eyebrow {
            display: inline-block;
            margin: 0 0 0.75rem;
            color: var(--accent-2);
            font-size: 0.95rem;
            font-weight: 500;
        }

        .section {
            padding: 6rem 0;
        }

        .section-head {
            max-width: 680px;
            margin: 0 auto 3.5rem;
            text-align: center;
        }

        .section-head h2 {
            margin: 0 0 0.75rem;
            font-size: clamp(2rem, 4.4vw, 2.75rem);
            font-weight: 700;
            line-height: 1.15;
            letter-spacing: -0.025em;
        }

        .section-head p {
            margin: 0 auto;
            color: var(--muted);
            font-size: 1.1rem;
        }

        /* =========================================================
         * Buttons
         * ========================================================= */
        .btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 0.5rem;
            padding: 0.75rem 1.3rem;
            border: 0;
            border-radius: 10px;
            font: inherit;
            font-size: 0.95rem;
            font-weight: 600;
            text-decoration: none;
            cursor: pointer;
            transition:
                transform 160ms ease,
                box-shadow 160ms ease,
                background-color 160ms ease,
                border-color 160ms ease;
        }

        .btn-primary {
            color: #ffffff;
            background: linear-gradient(180deg, #7b55f7 0%, #5a2fe0 100%);
            box-shadow:
                inset 0 1px 0 rgba(255, 255, 255, 0.25),
                0 0 0 1px rgba(124, 92, 255, 0.5),
                0 8px 30px -6px rgba(110, 70, 255, 0.7);
        }

        .btn-primary:hover {
            transform: translateY(-1px);
            box-shadow:
                inset 0 1px 0 rgba(255, 255, 255, 0.3),
                0 0 0 1px rgba(150, 120, 255, 0.7),
                0 10px 36px -6px rgba(120, 80, 255, 0.9);
        }

        .btn-ghost {
            color: var(--text);
            background: rgba(255, 255, 255, 0.04);
            box-shadow: inset 0 0 0 1px var(--border-strong);
        }

        .btn-ghost:hover {
            background: rgba(255, 255, 255, 0.08);
        }

        .btn-outline {
            padding: 0.5rem 0.95rem;
            border-radius: 8px;
            font-size: 0.875rem;
            background: transparent;
            box-shadow: inset 0 0 0 1px currentColor;
        }

        .btn-outline:hover {
            background: rgba(255, 255, 255, 0.05);
        }

        .btn-outline svg {
            width: 14px;
            height: 14px;
            transition: transform 160ms ease;
        }

        .btn-outline:hover svg {
            transform: translateX(2px);
        }

        /* =========================================================
         * Navigation
         * ========================================================= */
        .site-nav {
            position: sticky;
            top: 0;
            z-index: 50;
            transition: background-color 200ms ease, box-shadow 200ms ease;
        }

        .site-nav.is-scrolled {
            background: rgba(11, 10, 31, 0.78);
            -webkit-backdrop-filter: blur(14px);
            backdrop-filter: blur(14px);
            box-shadow: 0 1px 0 var(--border);
        }

        .site-nav .container {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 1rem;
            height: 72px;
        }

        .brand {
            display: flex;
            align-items: center;
            gap: 0.7rem;
            color: var(--text-strong);
            font-size: 1.05rem;
            font-weight: 700;
            text-decoration: none;
            white-space: nowrap;
        }

        .brand img {
            width: 34px;
            height: 34px;
            border-radius: 9px;
            box-shadow: 0 0 0 1px rgba(255, 255, 255, 0.15), 0 4px 18px rgba(80, 70, 255, 0.45);
        }

        .nav-links {
            display: flex;
            gap: 2rem;
            margin: 0;
            padding: 0;
            list-style: none;
        }

        .nav-links a {
            color: var(--text);
            font-size: 0.93rem;
            font-weight: 500;
            text-decoration: none;
            opacity: 0.85;
        }

        .nav-links a:hover {
            opacity: 1;
        }

        .nav-actions {
            display: flex;
            align-items: center;
            gap: 1rem;
        }

        .nav-actions .btn {
            padding: 0.6rem 1.05rem;
            font-size: 0.9rem;
        }

        /* Language selector (native <details>, works without JS) */
        .lang {
            position: relative;
        }

        .lang summary {
            display: flex;
            align-items: center;
            gap: 0.35rem;
            padding: 0.45rem 0.7rem;
            border-radius: 8px;
            color: var(--text);
            font-size: 0.9rem;
            font-weight: 500;
            list-style: none;
            cursor: pointer;
            opacity: 0.85;
        }

        .lang summary::-webkit-details-marker {
            display: none;
        }

        .lang summary:hover,
        .lang[open] summary {
            background: rgba(255, 255, 255, 0.06);
            opacity: 1;
        }

        .lang summary svg {
            width: 16px;
            height: 16px;
        }

        .lang-menu {
            position: absolute;
            top: calc(100% + 8px);
            right: 0;
            display: grid;
            min-width: 150px;
            padding: 0.4rem;
            border: 1px solid var(--border-strong);
            border-radius: 12px;
            background: rgba(22, 19, 52, 0.96);
            -webkit-backdrop-filter: blur(14px);
            backdrop-filter: blur(14px);
            box-shadow: 0 20px 50px -10px rgba(0, 0, 0, 0.6);
        }

        .lang-menu a {
            display: flex;
            justify-content: space-between;
            gap: 1rem;
            padding: 0.45rem 0.7rem;
            border-radius: 8px;
            color: var(--text);
            font-size: 0.9rem;
            text-decoration: none;
        }

        .lang-menu a span {
            color: var(--faint);
            font-size: 0.8rem;
            font-weight: 600;
        }

        .lang-menu a:hover {
            background: rgba(255, 255, 255, 0.07);
        }

        .lang-menu a[aria-current="page"] {
            color: var(--accent-2);
        }

        /* =========================================================
         * Hero
         * ========================================================= */
        .hero {
            position: relative;
            margin-top: -72px;
            padding: calc(72px + 5rem) 0 2rem;
            text-align: center;
            isolation: isolate;
            overflow: hidden;
        }

        /* Purple-navy sky glow */
        .hero::before {
            content: "";
            position: absolute;
            inset: 0;
            z-index: -2;
            background:
                radial-gradient(ellipse 70% 45% at 50% 0%, rgba(98, 76, 230, 0.45), transparent 70%),
                radial-gradient(ellipse 60% 40% at 50% 62%, rgba(32, 104, 255, 0.35), transparent 70%),
                linear-gradient(180deg, #17154a 0%, #0f0d33 40%, var(--bg) 100%);
        }

        /* Subtle grid lines */
        .hero::after {
            content: "";
            position: absolute;
            inset: 0;
            z-index: -1;
            background-image:
                linear-gradient(rgba(255, 255, 255, 0.045) 1px, transparent 1px),
                linear-gradient(90deg, rgba(255, 255, 255, 0.045) 1px, transparent 1px);
            background-size: 64px 64px;
            -webkit-mask-image: radial-gradient(ellipse 75% 55% at 50% 15%, #000 20%, transparent 75%);
            mask-image: radial-gradient(ellipse 75% 55% at 50% 15%, #000 20%, transparent 75%);
        }

        /* Diagonal light streaks */
        .streak {
            position: absolute;
            z-index: -1;
            width: 1px;
            height: 420px;
            background: linear-gradient(180deg, transparent, rgba(160, 170, 255, 0.55), transparent);
            pointer-events: none;
        }

        .streak--1 {
            top: 40px;
            left: 22%;
            transform: rotate(32deg);
        }

        .streak--2 {
            top: -40px;
            right: 18%;
            transform: rotate(-38deg);
            opacity: 0.7;
        }

        .streak--3 {
            top: 120px;
            right: 8%;
            height: 220px;
            transform: rotate(-58deg);
            opacity: 0.5;
        }

        .hero-badge {
            display: inline-flex;
            align-items: center;
            gap: 0.6rem;
            margin-bottom: 1.75rem;
            padding: 0.35rem 0.9rem 0.35rem 0.4rem;
            border-radius: 999px;
            color: var(--text);
            background: rgba(255, 255, 255, 0.05);
            box-shadow: inset 0 0 0 1px var(--border-strong);
            font-size: 0.85rem;
        }

        .hero-badge img {
            width: auto;
            height: 22px;
            padding: 3px 8px;
            border-radius: 999px;
            background: #ffffff;
        }

        .hero h1 {
            max-width: 900px;
            margin: 0 auto 1.25rem;
            font-size: clamp(2.5rem, 7vw, 4.6rem);
            font-weight: 800;
            line-height: 1.04;
            letter-spacing: -0.04em;
        }

        .hero-lead {
            max-width: 640px;
            margin: 0 auto 0.9rem;
            color: #c9c6ee;
            font-size: clamp(1.05rem, 2.2vw, 1.25rem);
        }

        .hero-sub {
            max-width: 600px;
            margin: 0 auto;
            color: var(--muted);
            font-size: 1rem;
        }

        .hero-sub + .hero-sub {
            margin-top: 1rem;
        }

        .hero-sub strong {
            color: var(--text);
            font-weight: 600;
        }

        .hero-cta {
            display: flex;
            flex-wrap: wrap;
            justify-content: center;
            gap: 0.75rem;
            margin-top: 2.25rem;
        }

        /* App window with glow */
        .app-window {
            position: relative;
            background: transparent;
        }

        .app-window__bar {
            display: flex;
            gap: 7px;
            padding: 12px 14px;
            background: #f6f6fa;
            border-bottom: 1px solid #ececf3;
        }

        .app-window__bar span {
            width: 11px;
            height: 11px;
            border-radius: 50%;
            background: #ff5f57;
        }

        .app-window__bar span:nth-child(2) {
            background: #febc2e;
        }

        .app-window__bar span:nth-child(3) {
            background: #28c840;
        }

        .hero-window-wrap {
            position: relative;
            max-width: 920px;
            margin: 4.5rem auto 0;
        }

        .hero-window-wrap::before {
            content: "";
            position: absolute;
            inset: 8% -6% -10%;
            z-index: -1;
            border-radius: 50%;
            background: radial-gradient(ellipse at center, rgba(40, 140, 255, 0.75), rgba(70, 70, 255, 0.35) 45%, transparent 70%);
            filter: blur(40px);
        }

        .app-window img {
            width: 100%;
            height: auto;
        }

        /* =========================================================
         * Feature icons (4 under hero + 8 services)
         * ========================================================= */
        .features {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 3rem 2rem;
            margin: 0;
            padding: 0;
            list-style: none;
            text-align: center;
        }

        .features--hero {
            padding: 5rem 0 1rem;
        }

        .feature-icon {
            display: grid;
            place-items: center;
            width: 44px;
            height: 44px;
            margin: 0 auto 1rem;
            color: #ffffff;
            filter: drop-shadow(0 0 10px rgba(150, 140, 255, 0.55));
        }

        .feature-icon svg {
            width: 32px;
            height: 32px;
        }

        .features h3 {
            margin: 0 0 0.35rem;
            color: var(--text-strong);
            font-size: 1.02rem;
            font-weight: 600;
        }

        .features p {
            max-width: 230px;
            margin: 0 auto;
            color: var(--muted);
            font-size: 0.93rem;
            line-height: 1.5;
        }

        /* =========================================================
         * Gradient panels
         * ========================================================= */
        .panel {
            position: relative;
            border-radius: var(--radius-lg);
            overflow: hidden;
            isolation: isolate;
            box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.18);
        }

        .panel+.panel {
            margin-top: 2.5rem;
        }

        .panel h2 {
            margin: 0 0 0.9rem;
            color: #ffffff;
            font-size: clamp(2rem, 4.2vw, 2.75rem);
            font-weight: 700;
            line-height: 1.12;
            letter-spacing: -0.025em;
        }

        .panel .eyebrow {
            color: rgba(255, 255, 255, 0.85);
        }

        .panel p {
            color: rgba(255, 255, 255, 0.78);
        }

        .panel--violet {
            background:
                radial-gradient(ellipse 60% 50% at 75% 0%, rgba(150, 120, 255, 0.35), transparent 70%),
                linear-gradient(180deg, #4a2ad3 0%, #6a2fdc 55%, #9a33d6 100%);
        }

        .panel--magenta {
            background:
                radial-gradient(ellipse 55% 45% at 50% 0%, rgba(230, 80, 200, 0.55), transparent 70%),
                linear-gradient(180deg, #9a2fcf 0%, #7b2ad8 55%, #4c1bd0 100%);
        }

        .panel--blue {
            background:
                radial-gradient(ellipse 60% 50% at 20% 100%, rgba(80, 140, 255, 0.4), transparent 70%),
                linear-gradient(180deg, #2a0f9c 0%, #2b2fc0 50%, #3263d8 100%);
        }

        /* faint vertical/horizontal guide lines like Reflect */
        .panel--lines::before {
            content: "";
            position: absolute;
            inset: 0;
            z-index: -1;
            background:
                linear-gradient(90deg, transparent calc(14% - 1px), rgba(255, 255, 255, 0.1) 14%, transparent calc(14% + 1px)),
                linear-gradient(90deg, transparent calc(86% - 1px), rgba(255, 255, 255, 0.1) 86%, transparent calc(86% + 1px)),
                linear-gradient(180deg, transparent 199px, rgba(255, 255, 255, 0.1) 200px, transparent 201px);
            pointer-events: none;
        }

        /* Split panel: text + visual */
        .panel-split {
            display: grid;
            grid-template-columns: 1fr 1.05fr;
            align-items: center;
            gap: 3rem;
            padding: 4.5rem 4rem;
        }

        .panel-split--reverse {
            grid-template-columns: 1.05fr 1fr;
        }

        .panel-split p.lead {
            max-width: 460px;
            margin: 0 0 2rem;
            font-size: 1.05rem;
        }

        .check-list {
            display: grid;
            gap: 0.85rem;
            margin: 0;
            padding: 0;
            list-style: none;
        }

        .check-list--2col {
            grid-template-columns: 1fr 1fr;
            gap: 0.8rem 1.5rem;
        }

        .check-list li {
            display: flex;
            align-items: flex-start;
            gap: 0.6rem;
            color: rgba(255, 255, 255, 0.92);
            font-size: 0.97rem;
            line-height: 1.45;
        }

        .check-list svg {
            flex: 0 0 auto;
            width: 19px;
            height: 19px;
            margin-top: 1px;
        }

        /* Network graph visual */
        .graph {
            position: relative;
        }

        .graph svg.graph-svg {
            width: 100%;
            height: auto;
            overflow: visible;
        }

        .graph-label {
            fill: #ffffff;
            font-family: inherit;
            font-size: 13px;
            font-weight: 600;
        }

        .graph-card {
            position: relative;
            display: grid;
            margin: 0.5rem 0 0 auto;
            gap: 0.85rem;
            width: min(260px, 70%);
            padding: 1rem;
            border-radius: 14px;
            background: rgba(120, 90, 240, 0.55);
            -webkit-backdrop-filter: blur(12px);
            backdrop-filter: blur(12px);
            box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.22), 0 20px 40px -10px rgba(30, 10, 90, 0.6);
            text-align: left;
        }

        .graph-card div {
            display: flex;
            align-items: center;
            gap: 0.7rem;
        }

        .graph-card img {
            width: 34px;
            height: 34px;
            border-radius: 8px;
            object-fit: cover;
        }

        .graph-card strong {
            display: block;
            color: #ffffff;
            font-size: 0.9rem;
            line-height: 1.2;
        }

        .graph-card small {
            display: block;
            color: rgba(255, 255, 255, 0.78);
            font-size: 0.8rem;
            line-height: 1.35;
        }

        .node-pulse {
            animation: pulse 3.2s ease-in-out infinite;
            transform-box: fill-box;
            transform-origin: center;
        }

        @keyframes pulse {

            0%,
            100% {
                opacity: 0.35;
                transform: scale(1);
            }

            50% {
                opacity: 0.8;
                transform: scale(1.35);
            }
        }

        /* Centered panel (CRM style) */
        .panel-center {
            padding: 4.5rem 2rem 0;
            text-align: center;
        }

        .panel-center p {
            max-width: 520px;
            margin: 0 auto;
            font-size: 1.05rem;
        }

        .ref-links {
            display: flex;
            flex-wrap: wrap;
            justify-content: center;
            gap: 0.6rem;
            max-width: 760px;
            margin: 2rem auto 0;
            padding: 0;
            list-style: none;
        }

        .ref-links a {
            display: inline-flex;
            align-items: center;
            gap: 0.45rem;
            padding: 0.55rem 1rem;
            border-radius: 999px;
            color: #ffffff;
            background: rgba(255, 255, 255, 0.12);
            box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.25);
            font-size: 0.92rem;
            font-weight: 500;
            text-decoration: none;
            transition: background-color 160ms ease, transform 160ms ease;
        }

        .ref-links a:hover {
            background: rgba(255, 255, 255, 0.22);
            transform: translateY(-1px);
        }

        .ref-links svg {
            width: 14px;
            height: 14px;
            opacity: 0.8;
        }

        .panel-center .app-window {
            max-width: 900px;
            margin: 3.5rem auto 0;
        }

        .panel-center .app-window img {
            display: block;
        }

        /* Screenshot card on blue panel */
        .shot-card {
            background: transparent;
        }

        .shot-card img {
            width: 100%;
            height: auto;
        }

        .mini-features {
            display: grid;
            gap: 1.75rem;
            margin: 2.25rem 0 0;
            padding: 0;
            list-style: none;
        }

        .mini-features li {
            display: flex;
            gap: 1.1rem;
        }

        .mini-features .mini-icon {
            flex: 0 0 auto;
            width: 40px;
            height: 40px;
            color: #ffffff;
        }

        .mini-features h3 {
            margin: 0 0 0.25rem;
            color: #ffffff;
            font-size: 1.02rem;
            font-weight: 600;
        }

        .mini-features p {
            margin: 0;
            font-size: 0.95rem;
            line-height: 1.5;
        }

        /* =========================================================
         * Flutter apps for every screen panel
         * ========================================================= */
